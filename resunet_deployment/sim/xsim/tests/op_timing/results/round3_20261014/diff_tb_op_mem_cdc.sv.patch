--- /dev/null
+++ prj/Model_Deployment.srcs/sim_1/new/Op_Timing/tb_op_mem_cdc.sv
@@ -0,0 +1,142 @@
+`timescale 1ns/1ps
+// 【文件类型：.sv】跨域事务自校验：不含算法模型，检查完整载荷、反压、错误与复位取消。
+module tb_op_mem_cdc;
+    logic compute_clk = 1'b0, ui_clk = 1'b0, rst_n = 1'b0;
+    realtime compute_half = 4.0, ui_half = 1.5;
+    always #(compute_half) compute_clk = !compute_clk;
+    initial begin #0.37; forever #(ui_half) ui_clk = !ui_clk; end
+    logic req_valid = 1'b0, req_ready, rsp_valid, rsp_ready = 1'b0;
+    logic [319:0] req_payload = 320'd0, expected_request, ui_payload;
+    logic [256:0] response, expected_response;
+    logic ui_req, ui_ready, ui_rsp = 1'b0, ui_rsp_ready, active;
+    logic [256:0] ui_response = 257'd0;
+    logic allow_ui = 1'b1, allow_return = 1'b1;
+    integer ui_cycle = 0, cycle = 0, phase = 0, delay_count = 0;
+    integer received = 0, returned = 0, passed = 0, resets = 0, csv;
+    logic ui_stalled = 1'b0, compute_stalled = 1'b0;
+    logic [319:0] ui_held;
+    logic [256:0] response_held;
+
+    op_mem_cdc dut (
+        .compute_clk_i(compute_clk), .compute_rst_n_i(rst_n), .ui_clk_i(ui_clk), .ui_rst_n_i(rst_n),
+        .req_valid_i(req_valid), .req_ready_o(req_ready), .req_write_i(req_payload[319]),
+        .req_addr_i(req_payload[318:288]), .req_data_i(req_payload[287:32]), .req_mask_i(req_payload[31:0]),
+        .rsp_valid_o(rsp_valid), .rsp_ready_i(rsp_ready), .rsp_error_o(response[256]), .rsp_data_o(response[255:0]),
+        .ui_req_valid_o(ui_req), .ui_req_ready_i(ui_ready), .ui_req_write_o(ui_payload[319]),
+        .ui_req_addr_o(ui_payload[318:288]), .ui_req_data_o(ui_payload[287:32]), .ui_req_mask_o(ui_payload[31:0]),
+        .ui_rsp_valid_i(ui_rsp), .ui_rsp_ready_o(ui_rsp_ready), .ui_rsp_error_i(ui_response[256]),
+        .ui_rsp_data_i(ui_response[255:0]), .active_ui_o(active)
+    );
+    assign ui_ready = allow_ui && phase == 0 && ui_cycle % 5 != 0;
+    always @(posedge ui_clk or negedge rst_n) begin
+        if (!rst_n) begin
+            phase <= 0; delay_count <= 0; ui_rsp <= 1'b0; ui_stalled <= 1'b0;
+        end else begin
+            ui_cycle = ui_cycle + 1;
+            if (ui_stalled && (ui_req !== 1'b1 || ui_payload !== ui_held)) begin
+                $error("UI request changed during stall time=%t", $time); $stop;
+            end
+            ui_stalled <= ui_req && !ui_ready;
+            ui_held <= ui_payload;
+            if (ui_req && ui_ready) begin
+                if (ui_payload !== expected_request || active !== 1'b1) begin
+                    $error("request mismatch time=%t expected=%h actual=%h",$time,expected_request,ui_payload); $stop;
+                end
+                received = received + 1;
+                phase <= 1; delay_count <= 2 + ui_cycle % 9;
+                ui_response <= expected_response;
+            end
+            if (phase == 1 && allow_return) begin
+                if (delay_count == 0) begin ui_rsp <= 1'b1; phase <= 2; end
+                else delay_count <= delay_count - 1;
+            end
+            if (ui_rsp && ui_rsp_ready) begin ui_rsp <= 1'b0; phase <= 0; end
+        end
+    end
+    always @(posedge compute_clk or negedge rst_n) begin
+        if (!rst_n) compute_stalled <= 1'b0;
+        else begin
+            cycle = cycle + 1;
+            $fdisplay(csv,"%0d,%t,%b,%b,%b,%b,%b,%b,%b,%b",cycle,$time,req_valid,req_ready,ui_req,ui_ready,ui_rsp,ui_rsp_ready,rsp_valid,rsp_ready);
+            if (compute_stalled && (rsp_valid !== 1'b1 || response !== response_held)) begin
+                $error("response changed during stall cycle=%0d",cycle); $stop;
+            end
+            compute_stalled <= rsp_valid && !rsp_ready;
+            response_held <= response;
+            if (rsp_valid && rsp_ready) begin
+                if (response !== expected_response || req_ready !== 1'b0) begin
+                    $error("response mismatch cycle=%0d expected=%h actual=%h",cycle,expected_response,response); $stop;
+                end
+                returned = returned + 1;
+            end
+        end
+    end
+    task automatic send_request(input int index);
+        @(negedge compute_clk);
+        expected_request = {1'(index%2),31'(32'h10000000+index*32),{8{32'hac130000 ^ 32'(index)}},32'hf00f0101 ^ 32'(index)};
+        expected_response = {1'(index%7==0),expected_request[287:32] ^ {8{32'h5aa5c33c}}};
+        req_payload = expected_request; req_valid = 1'b1;
+        do @(posedge compute_clk); while (!req_ready);
+        @(negedge compute_clk); req_valid = 1'b0;
+        // 上游握手后可立即换数据；桥必须使用已锁存载荷。
+        req_payload = ~expected_request;
+    endtask
+    task automatic receive_response(input int stall_cycles);
+        wait(rsp_valid === 1'b1);
+        repeat(stall_cycles) @(negedge compute_clk);
+        @(negedge compute_clk); rsp_ready = 1'b1;
+        @(negedge compute_clk); rsp_ready = 1'b0;
+        if (rsp_valid !== 1'b0 || req_ready !== 1'b1) begin
+            $error("response was not consumed time=%t",$time); $stop;
+        end
+        passed = passed + 1;
+    endtask
+    task automatic reset_bridge;
+        #0.63; rst_n = 1'b0; req_valid = 1'b0; rsp_ready = 1'b0;
+        repeat(5) @(negedge compute_clk);
+        rst_n = 1'b1;
+        repeat(8) @(negedge compute_clk);
+        if (rsp_valid !== 1'b0 || ui_req !== 1'b0 || active !== 1'b0 || req_ready !== 1'b1) begin
+            $error("phantom transaction after reset time=%t",$time); $stop;
+        end
+        resets = resets + 1;
+    endtask
+    initial begin
+        csv = $fopen("sim_trace.csv","w");
+        $fdisplay(csv,"cycle,time,req_valid,req_ready,ui_req,ui_ready,ui_rsp,ui_rsp_ready,rsp_valid,rsp_ready");
+        $dumpfile("waveform.vcd"); $dumpvars(0,tb_op_mem_cdc);
+        reset_bridge();
+        for (int ratio=0; ratio<3; ratio++) begin
+            case(ratio)
+                0: begin compute_half=4.0; ui_half=1.5; end
+                1: begin compute_half=2.5; ui_half=5.5; end
+                2: begin compute_half=4.13; ui_half=1.49; end
+            endcase
+            for (int n=0; n<64; n++) begin
+                send_request(64*ratio+n);
+                receive_response(n%13);
+            end
+        end
+        // 复位覆盖：目的请求受阻、等待DDR响应、响应已跨回但尚未消费。
+        for (int stage=0; stage<3; stage++) begin
+            allow_ui = stage != 0; allow_return = stage != 1;
+            send_request(300+stage);
+            case(stage)
+                0: wait(ui_req === 1'b1);
+                1: wait(phase == 1);
+                2: wait(rsp_valid === 1'b1);
+            endcase
+            reset_bridge();
+            allow_ui = 1'b1; allow_return = 1'b1;
+            send_request(400+stage); receive_response(5);
+        end
+        repeat(20) @(negedge compute_clk);
+        if (passed !== 195 || returned !== 195 || received !== 197 || rsp_valid !== 1'b0 || active !== 1'b0) begin
+            $error("count/idle mismatch passed=%0d returned=%0d received=%0d",passed,returned,received); $stop;
+        end
+        $fclose(csv);
+        $display("[TB PASSED] CDC transactions=%0d resets=%0d clock_ratios=3 received=%0d cycles=%0d",passed,resets,received,cycle);
+        $finish;
+    end
+    initial begin repeat(20000) @(posedge compute_clk); $fatal(1,"CDC timeout"); end
+endmodule
